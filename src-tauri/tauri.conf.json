{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Controller Toolkit",
  "version": "../package.json",
  "identifier": "com.robin.steamcontrollerapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Steam Controller Toolkit",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/60-steam-controller-toolkit.rules": "linux/60-steam-controller-toolkit.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/60-steam-controller-toolkit.rules": "linux/60-steam-controller-toolkit.rules"
        },
        "postInstallScript": "linux/postinst.sh"
      }
    }
  }
}
